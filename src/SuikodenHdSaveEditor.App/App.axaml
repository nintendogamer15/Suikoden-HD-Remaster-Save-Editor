<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:SaveEditor.Ui.Theming;assembly=SaveEditor.Ui"
             x:Class="SuikodenHdSaveEditor.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- A base Avalonia theme first, then the framework's, which redefines the control
             themes in terms of semantic tokens. The editor no longer carries its own control
             styling: the hardcoded hex values it used to set were not theme-aware, which is
             why the error banner was unreadable in dark mode. -->
        <FluentTheme />
        <theming:SaveEditorTheme />
    </Application.Styles>
</Application>
