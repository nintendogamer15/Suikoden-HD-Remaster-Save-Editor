<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuikodenHdSaveEditor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="780"
        x:Class="SuikodenHdSaveEditor.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Border Grid.Row="0" Background="#17233C" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <StackPanel>
                    <TextBlock Text="S I · II" FontSize="22" FontWeight="Bold" Foreground="#DCE7FF" />
                    <TextBlock Text="HD SAVE EDITOR" FontSize="10" LetterSpacing="1.5" Foreground="#91A9DA" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="primary" Content="Open Save" Command="{Binding OpenSaveCommand}" />
                        <Button Content="Open Save Folder" Command="{Binding OpenFolderCommand}" />
                        <Button Content="Save As" Command="{Binding SaveAsCommand}" />
                        <Button Classes="danger" Content="Overwrite + Backup" Command="{Binding OverwriteCommand}" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" />
                        <Button Content="Undo" Command="{Binding UndoCommand}" />
                        <Button Content="Redo" Command="{Binding RedoCommand}" />
                        <Button Content="About / Credits" Command="{Binding AboutCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Detected save" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DetectedGame}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SlotText, StringFormat='Slot {0}'}" />
                            <TextBlock Text="{Binding UnsavedText}" Foreground="#C77C22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Editor sections" FontSize="12" FontWeight="SemiBold" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" />

                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Text="Recent paths" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecentFile}" />
                        <Button Content="Open recent" Command="{Binding OpenRecentCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Spacing="6">
                        <TextBlock Text="Folder slots" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableSlots}" SelectedItem="{Binding SelectedSlot}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlotEntryViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Open selected slot" Command="{Binding OpenSelectedSlotCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="12">
                <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding SelectedSection}" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Review values, then apply one field or all fields in this section." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" IsVisible="{Binding IsSearchVisible}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search characters, items, or IDs" />
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCharacters}">
                                <TextBlock Text="Character filter" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox Width="160" ItemsSource="{Binding CharacterFilters}" SelectedItem="{Binding SelectedCharacterFilter}" />
                                <ComboBox Width="260" ItemsSource="{Binding CharacterChoices}" SelectedItem="{Binding SelectedCharacter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChoiceViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsInventory}">
                                <Button IsVisible="{Binding IsSuikoden2}" Content="Give all safe party items" Command="{Binding GiveAllSafeItemsCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsRecruitment}">
                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsSuikoden2}">
                                    <CheckBox Content="Better Leona installed" IsChecked="{Binding BetterLeonaEnabled}" />
                                    <CheckBox Content="Kraken recruitment installed" IsChecked="{Binding KrakenRecruitmentEnabled}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="#FDE7E9" BorderBrush="#D65C66" BorderThickness="1" CornerRadius="7" Padding="12">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#7A1F27" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer IsVisible="{Binding IsFieldEditor}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditorFieldViewModel">
                                    <Border Classes="card" Margin="0,0,0,9">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="260,*,Auto" ColumnSpacing="12" RowSpacing="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" IsVisible="{Binding UsesTextEntry}" />
                                            <AutoCompleteBox Grid.Column="1"
                                                             Text="{Binding Value, Mode=TwoWay}"
                                                             ItemsSource="{Binding Choices}"
                                                             IsVisible="{Binding HasChoices}"
                                                             FilterMode="ContainsOrdinal"
                                                             MinimumPrefixLength="0"
                                                             IsTextCompletionEnabled="True"
                                                             PlaceholderText="Type a name, ID, or category" />
                                            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyCommand}" MinWidth="76" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding HasWarning}" Text="{Binding Warning}" Foreground="#B36B16" TextWrapping="Wrap" FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Classes="card" IsVisible="{Binding IsAdvancedData}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <StackPanel>
                                <TextBlock Text="Read-only lossless JSON document" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Raw editing is intentionally disabled. Unknown fields remain untouched unless a verified normal editor changes their exact path." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding RawJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" />
                        </Grid>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding IsCredits}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Credits · licenses · fan-project disclaimer" FontSize="18" FontWeight="SemiBold" />
                            <TextBox Grid.Row="1" Text="{Binding CreditsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OriginalPath, StringFormat='Current path: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BackupPath, StringFormat='Last backup: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="Apply All" Command="{Binding ApplyAllCommand}" IsVisible="{Binding IsApplyAllVisible}" VerticalAlignment="Center" MinWidth="120" />
            </Grid>
        </Border>
    </Grid>
</Window>
